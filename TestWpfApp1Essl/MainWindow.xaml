<Window x:Class="TestWpfApp1Essl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="eSSL device test" Height="640" Width="900" Closed="Window_Closed">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="320" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" x:Name="panelInputs" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="IP" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox x:Name="txtIp" Text="192.168.29.201" Width="120" />
            <TextBlock Text="Comm key" VerticalAlignment="Center" Margin="12,0,4,0" />
            <TextBox x:Name="txtCommKey" Text="000000" Width="70" />
            <TextBlock Text="User ID" VerticalAlignment="Center" Margin="12,0,4,0" />
            <TextBox x:Name="txtUserId" Text="1001" Width="60" />
            <TextBlock Text="Name" VerticalAlignment="Center" Margin="12,0,4,0" />
            <TextBox x:Name="txtName" Text="Pravin_Test" Width="110" />
            <TextBlock Text="Finger" VerticalAlignment="Center" Margin="12,0,4,0" />
            <TextBox x:Name="txtFinger" Text="0" Width="30" />
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <Button x:Name="btnCancel" DockPanel.Dock="Right" Content="Cancel" Click="Cancel_Click" IsEnabled="False" Width="90" Height="30" />
            <Button x:Name="btnDone" DockPanel.Dock="Right" Content="Done" Click="Done_Click" IsEnabled="False" Width="90" Height="30" Margin="0,0,8,0" />
        <WrapPanel x:Name="panelActions">
            <Button Content="Device info" Click="DeviceInfo_Click" Width="110" Height="30" Margin="0,0,8,0" />
            <Button Content="Add user" Click="AddUser_Click" Width="110" Height="30" Margin="0,0,8,0" />
            <Button Content="Enroll finger" Click="EnrollFinger_Click" Width="110" Height="30" Margin="0,0,8,0" />
            <Button Content="Enroll face" Click="EnrollFace_Click" Width="110" Height="30" Margin="0,0,8,0" />
            <Button Content="Listen events" Click="ListenEvents_Click" Width="110" Height="30" Margin="0,0,8,0" />
            <Button Content="Delete finger" Click="DeleteFinger_Click" Width="110" Height="30" Margin="0,0,8,0" />
            <Button Content="Sync (clears device log)" Click="Sync_Click" Width="160" Height="30" />
        </WrapPanel>
        </DockPanel>
        <TextBlock Grid.Row="2" x:Name="txtDeviceInfo" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,6" />
        <DataGrid Grid.Row="3" x:Name="gridUsers" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" CanUserAddRows="False" SelectionMode="Single"
                  SelectionChanged="GridUsers_SelectionChanged" Margin="0,0,0,8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="User ID" Binding="{Binding UserId}" Width="70" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="90" />
                <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="65" />
                <DataGridCheckBoxColumn Header="Password" Binding="{Binding HasPassword}" Width="70" />
                <DataGridTextColumn Header="Card" Binding="{Binding CardNumber}" Width="100" />
                <DataGridTextColumn Header="Fingers" Binding="{Binding FingerCount}" Width="60" />
                <DataGridTextColumn Header="Finger slots" Binding="{Binding FingerSlots}" Width="90" />
                <DataGridCheckBoxColumn Header="Face" Binding="{Binding HasFace}" Width="50" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBox Grid.Row="4" x:Name="txtLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas" />
    </Grid>
</Window>
