<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Match Passoft (net48, x86, C# 7.3) so Manager\*.cs can be copied across unchanged -->
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <!-- Same layout as Passoft\Ref: interop assemblies in Ref, ZKTeco Standalone SDK 6.3.1.55 (x86) in Ref\eTimeTrack -->
  <ItemGroup>
    <Reference Include="AxInterop.zkemkeeper">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>Ref\AxInterop.zkemkeeper.dll</HintPath>
    </Reference>
    <Reference Include="Interop.zkemkeeper">
      <SpecificVersion>False</SpecificVersion>
      <EmbedInteropTypes>False</EmbedInteropTypes>
      <HintPath>Ref\Interop.zkemkeeper.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="Ref\tcpcomm.dll;Ref\eTimeTrack\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
